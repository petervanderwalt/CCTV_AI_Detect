# Copy this file to .env and replace the placeholders. Never commit .env.
CAMERAS_JSON=[{"id":"driveway","name":"Driveway","rtsp_url":"rtsp://USERNAME:PASSWORD@192.168.0.71:554/stream1","detect_every_seconds":1.0}]
DATA_DIR=./data
MODEL_PATH=models/yolo11n.pt
PERSON_CONFIDENCE=0.55
ALARM_COOLDOWN_SECONDS=45
CLIP_SECONDS=20
# Windows: set this if ffmpeg.exe is not on PATH.
FFMPEG_PATH=ffmpeg

# Optional: Telegram bot notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: URL called after a confirmed alarm, e.g. an ESP32 siren endpoint
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_METHOD=POST

# Optional: GPIO only works on a Raspberry Pi running this service.
GPIO_PIN=
GPIO_ACTIVE_SECONDS=10

# Optional: local Tuya/Smart Life Wi-Fi switch (no cloud call during alarms)
# Get the device ID and local key from your Tuya IoT project; protocol is usually 3.3.
TUYA_DEVICE_ID=
TUYA_DEVICE_IP=
TUYA_LOCAL_KEY=
TUYA_PROTOCOL_VERSION=3.3
TUYA_SWITCH_DPS=1
TUYA_ACTIVE_SECONDS=10
